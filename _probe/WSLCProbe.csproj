<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- 与主项目同一 TFM 家族：AutoStart 用 HKCU 注册表（Windows-only），
         声明成 net8.0-windows 后平台分析器才能认清调用站点合法（否则一堆 CA1416）。 -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>12.0</LangVersion>
    <AssemblyName>WSLCProbe</AssemblyName>
    <RootNamespace>WSLCProbe</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
    <!-- AutoStart.cs 要读写 HKCU\...\Run：这个包让 net8.0（非 windows TFM）也能编译注册表 API。
         探针本身仍然只在 Windows 上跑。 -->
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
  </ItemGroup>

  <!-- 直接复用主项目源码，不做代码复制 -->
  <ItemGroup>
    <Compile Include="..\Models\ContainerInfo.cs" />
    <Compile Include="..\Models\ImageInfo.cs" />
    <Compile Include="..\Models\ImageUsage.cs" />
    <Compile Include="..\Models\ContainerStats.cs" />
    <Compile Include="..\Models\ContainerSpec.cs" />
    <Compile Include="..\Models\NetworkInfo.cs" />
    <Compile Include="..\Services\ProcRunner.cs" />
    <Compile Include="..\Services\TableParser.cs" />
    <Compile Include="..\Services\WslcService.cs" />
    <Compile Include="..\Services\RestorePlanner.cs" />
    <Compile Include="..\Services\InstallService.cs" />
    <Compile Include="..\Services\ImageSearchService.cs" />
    <Compile Include="..\Services\NetworkValidator.cs" />
    <Compile Include="..\Helpers\DiskCompactor.cs" />
    <Compile Include="..\Helpers\NetMeter.cs" />
    <Compile Include="..\Helpers\AppSettings.cs" />
    <Compile Include="..\Helpers\AutoStart.cs" />
  </ItemGroup>

</Project>
