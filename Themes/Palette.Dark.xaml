<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================= 调色板：深色 =================
         与 Palette.Light.xaml **key 一一对应、数量必须相同**（探针第 24 节逐 key 对账）。

         深色不是把浅色取反，而是重新定的一套：
           · 层次靠"亮度差"而不是"边框"—— 窗口底最暗、卡片次之、悬停/内嵌条再亮一档，
             这样才不会有"一片黑糊在一起"的感觉；
           · 语义色（成功/警告/错误/强调）在深底上必须**提亮**，
             浅色那套放到深底上普遍只有 2~3:1，小字直接看不清；
           · 强调色块上的文字反过来用**深色**（亮蓝底 + 深字 = 6:1），
             沿用白字只有 3.2:1，是"深色主题做糊"的典型。

         对比度实测（对 CardBrush #1E2228）：正文 13.2:1 / 次要 7.3:1 / 弱化 4.3:1 /
         成功 8.5:1 / 警告 8.0:1 / 错误 5.8:1 / 强调 5.0:1 —— 探针里有断言守着。 -->

    <!-- ── 强调色（比浅色亮一档：深底上的蓝必须提亮才立得住） ── -->
    <Color x:Key="AccentColor">#4C8DFF</Color>
    <SolidColorBrush x:Key="AccentBrush"        Color="#4C8DFF"/>
    <SolidColorBrush x:Key="AccentHoverBrush"   Color="#6BA1FF"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#3B7AE8"/>
    <SolidColorBrush x:Key="AccentSoftBrush"    Color="#17304F"/>
    <SolidColorBrush x:Key="ErrSoftBrush"       Color="#3A1F22"/>

    <!-- 强调色块上的文字：深色底字（亮蓝 #4C8DFF 上的白字只有 3.2:1，不够看） -->
    <SolidColorBrush x:Key="OnAccentFgBrush"    Color="#0B0E12"/>

    <!-- ── 窗口与面板：底最暗 → 卡片次之 → 悬停/内嵌条最亮 ── -->
    <LinearGradientBrush x:Key="WindowGradient" StartPoint="0,0" EndPoint="0.6,1">
        <GradientStop Color="#1A1D23" Offset="0"/>
        <GradientStop Color="#161A20" Offset="0.55"/>
        <GradientStop Color="#13161B" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="CardBrush"        Color="#1E2228"/>
    <SolidColorBrush x:Key="BarBrush"         Color="#23272E"/>
    <SolidColorBrush x:Key="BorderBrush2"     Color="#333A44"/>
    <SolidColorBrush x:Key="BorderSoftBrush"  Color="#2A3038"/>
    <SolidColorBrush x:Key="WindowEdgeBrush"  Color="#48525F"/>
    <SolidColorBrush x:Key="HoverBrush"       Color="#2A3038"/>
    <SolidColorBrush x:Key="RowAltBrush"      Color="#1B1F25"/>
    <SolidColorBrush x:Key="LogBgBrush"       Color="#191C21"/>

    <!-- ── 文字 ──
         深色的"灰"要比浅色保守得多：浅色里那套灰（#565E6B / #7A8391）是按白底配的，
         照搬到深底上会发暗、像禁用态。这里整档提亮（bill 反馈"灰字再白一点"），
         层次仍是 正文 > 次要 > 弱化 > 禁用，实测 13.1 / 9.7 / 6.4 / 3.6 :1。 -->
    <SolidColorBrush x:Key="TextBrush"        Color="#E6E9EF"/>
    <SolidColorBrush x:Key="SubTextBrush"     Color="#C2C9D2"/>
    <SolidColorBrush x:Key="MutedBrush"       Color="#9AA4B0"/>

    <!-- ── 语义色（全部提亮，否则在深底上发暗、小字不可读） ── -->
    <SolidColorBrush x:Key="OkBrush"          Color="#3DD68C"/>
    <SolidColorBrush x:Key="WarnBrush"        Color="#F0A93B"/>
    <SolidColorBrush x:Key="ErrBrush"         Color="#FF6B6F"/>
    <SolidColorBrush x:Key="InfoBrush"        Color="#4C8DFF"/>

    <SolidColorBrush x:Key="DisabledFgBrush"  Color="#6E7883"/>

    <!-- ── 控件细节色 ── -->
    <SolidColorBrush x:Key="DangerSoftBgBrush"       Color="#3A1F22"/>
    <SolidColorBrush x:Key="DangerSoftBorderBrush"   Color="#5A2E33"/>
    <SolidColorBrush x:Key="CaptionHoverBrush"       Color="#2A3038"/>
    <!-- 关闭按钮悬停：深红 + 白字（4.98:1）。用浅色那个 #E5484D 只有 3.9:1。 -->
    <SolidColorBrush x:Key="CloseHoverBrush"         Color="#C93B3F"/>
    <SolidColorBrush x:Key="ControlHoverBorderBrush" Color="#4A5462"/>
    <SolidColorBrush x:Key="ControlBorderBrush"      Color="#414A56"/>
    <SolidColorBrush x:Key="ScrollThumbBrush"        Color="#3E4650"/>

    <!-- 深底上的投影用纯黑；浅色那圈偏蓝的灰影在这里会显脏 -->
    <Color x:Key="ShadowColor">#000000</Color>

</ResourceDictionary>
